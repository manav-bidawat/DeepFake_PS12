# VoiceLab runtime mode
VOICELAB_ENABLE_TTS=false

# FastAPI bind settings
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=7860

# Detection checkpoints
AASIST_CHECKPOINT_PATH=models/checkpoints/ModelA_LA_bestnew.pt
AASIST_CHECKPOINT_B_PATH=models/checkpoints/ModelB_PA_bestnew.pt
AASIST_THRESHOLD=0.420
AASIST_THRESHOLD_B=0.118

# Optional XTTS generation settings.
# Set VOICELAB_ENABLE_TTS=true and provide either XTTS_MODEL_PATH or all explicit paths.
XTTS_MODEL_PATH=
XTTS_CHECKPOINT_PATH=
XTTS_CONFIG_PATH=
XTTS_VOCAB_PATH=

# Optional explainability/similarity rules used by generation results.
SURROGATE_RULES_PATH=explainability/global_surrogate/decision_tree_rules.txt

